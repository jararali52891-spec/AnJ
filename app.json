{
  "expo": {
    "name": "Jarar & Aamna",
    "slug": "jarar",
    "owner": "jararalis-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.jararaamna.sync",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Jarar & Aamna Sync to update location in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to measure your heart rate."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "73fab910-1735-4f08-a809-e37682828f13"
      }
    }
  }
}
